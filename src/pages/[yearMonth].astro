---
import Layout from '../layouts/Layout.astro';
import ArchiveList from '../components/ArchiveList.astro';
import DayDisplay from '../components/DayDisplay.astro';

import { getMonthlyArchives } from '../utils/archives';

import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

export const getStaticPaths = (async () => {
  const archives = await getMonthlyArchives();

  return archives.map(({ yearMonth, days }) => ({
    params: { yearMonth },
    props: { days },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { days } = Astro.props;
---

<Layout title="News" description="Hacker News and Lobsters daily aggregator">
  <h1><a href="/">News</a></h1>
  {days.map((day) => <DayDisplay day={day} />)}

  <ArchiveList />

  <p>By <a href="https://hawksley.dev/">Ethan Hawksley</a></p>
</Layout>

<style>
  a {
    color: inherit;
    text-decoration: none;
  }

  p {
    margin-top: 1rem;
    line-height: var(--leading-normal);
  }
</style>
