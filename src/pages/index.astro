---
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import ArchiveList from '../components/ArchiveList.astro';
import DayDisplay from '../components/DayDisplay.astro';

const days = await getCollection('days');
const descendingDays = days.toSorted((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const fiveLatestDays = descendingDays.slice(0, 5);
---

<Layout title="News" description="Hacker News and Lobsters daily aggregator">
  <h1><a href="/">News</a></h1>
  {fiveLatestDays.map((day) => <DayDisplay day={day} />)}

  <ArchiveList />

  <div>
    <p>
      By <a href="https://hawksley.dev/">Ethan Hawksley</a>
    </p>
    <p><a href="https://github.com/ethanhawksley/news">GitHub</a></p>
  </div>
</Layout>

<style>
  a {
    color: inherit;
    text-decoration: none;
  }

  div {
    padding-top: 1.5rem;
    line-height: var(--leading-normal);
    border-top: 1px solid var(--color-border);
  }
</style>
