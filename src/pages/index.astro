---
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import DayDisplay from '../components/DayDisplay.astro';

const days = await getCollection('days');
const descendingDays = days.toSorted((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const fiveLatestDays = descendingDays.slice(0, 5);
---

<Layout title="News" description="Hacker News and Lobsters daily aggregator">
  <h1>News</h1>
  {fiveLatestDays.map((day) => <DayDisplay day={day} />)}
  <p>By <a href="https://hawksley.dev/">Ethan Hawksley</a></p>
</Layout>

<style>
  a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  p {
    margin-top: 1rem;
    line-height: var(--leading-normal);
  }
</style>
