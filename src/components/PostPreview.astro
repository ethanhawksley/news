---
import type { Post } from '../content.config';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<li>
  <div>
    <a href={post.url} rel="nofollow ugc" class="title">{post.title}</a>{
      ' '
    }<small class="domain">[{post.domain}]</small>
  </div>
  <small>
    <a href={post.comments} class="comments">Comments</a>
  </small>
</li>

<style>
  li {
    margin-bottom: 0.75rem;
  }

  li:last-child {
    margin-bottom: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .title {
    font-weight: var(--weight-medium);
  }

  .title:visited {
    color: var(--color-text-muted);
  }

  small {
    color: var(--color-text-muted);
  }
</style>
